#!/usr/bin/env bash
set -u

PROJECTS_DIR="${CLAUDE_PROJECTS_DIR:-$HOME/.claude/projects}"

usage() {
  cat <<'USAGE'
Usage:
  claude-turns [limit]
  claude-turns --limit <n>
  claude-turns [limit] --json

Lists recent unique Claude Code assistant turns from ~/.claude/projects.
USAGE
}

die() { echo "Error: $*" >&2; exit 1; }

command -v jq >/dev/null 2>&1 || die "jq is required."
[[ -d "$PROJECTS_DIR" ]] || die "Claude projects directory not found: $PROJECTS_DIR"

limit=10
output_mode="table"

while (( $# > 0 )); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --json) output_mode="json"; shift ;;
    -n|--limit)
      (( $# >= 2 )) || die "$1 requires a value."
      limit="$2"; shift 2 ;;
    *[!0-9]*|'') die "Unknown argument: $1" ;;
    *) limit="$1"; shift ;;
  esac
done

[[ "$limit" =~ ^[1-9][0-9]*$ ]] || die "Limit must be a positive integer."

tmp="$(mktemp -t claude-turns.XXXXXX)"
trap 'rm -f "$tmp"' EXIT INT TERM

while IFS= read -r -d '' file; do
  jq -rcs --arg file "$file" '
    ([.[]
      | (.cwd // .projectPath // empty)
      | select(type == "string" and length > 0)
    ] | first // "") as $file_source
    | .[]
    | select(.type == "assistant")
    | select(.message.usage? != null)
    | select((.uuid // "") | type == "string" and length > 0)
    | {
        timestamp: (.timestamp // ""),
        turn_id: .uuid,
        message_id: (.message.id // .uuid),
        session_id: (.sessionId // ""),
        model: (.message.model // ""),
        source: (.cwd // .projectPath // $file_source // "")
      }
  ' "$file" 2>/dev/null
done < <(find "$PROJECTS_DIR" -type f -name '*.jsonl' -print0) \
  | jq -sc --argjson limit "$limit" '
      sort_by(.timestamp)
      | group_by(.message_id)
      | map(max_by(.timestamp))
      | sort_by(.timestamp) | reverse
      | .[:$limit]
      | map(. + {
          short_id: ("T-" + .turn_id[-8:]),
          root_turn_id: null,
          short_root_id:
            (
              if (.session_id | length) > 0 then
                ("S-" + .session_id[-8:])
              else
                "-"
              end
            )
        })
    ' > "$tmp"

if [[ "$output_mode" == "json" ]]; then
  cat "$tmp"
  exit 0
fi

printf "%-22s %-11s %-11s %-38s %-38s %-24s %s\n" \
  "TIME" "SHORT-ID" "ROOT-ID" "SESSION-ID" "TURN-ID" "MODEL" "SOURCE"

jq -r '.[] | [
  .timestamp,
  .short_id,
  .short_root_id,
  (.session_id // ""),
  .turn_id,
  (.model // ""),
  (.source // "")
] | @tsv' "$tmp" |
while IFS=$'\t' read -r ts short root session turn model source; do
  printf "%-22s %-11s %-11s %-38s %-38s %-24s %s\n" \
    "$ts" "$short" "$root" "${session:--}" "$turn" "${model:--}" "${source:--}"
done
