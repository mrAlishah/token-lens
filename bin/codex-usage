#!/usr/bin/env bash
set -u

SESSIONS_DIR="${CODEX_SESSIONS_DIR:-$HOME/.codex/sessions}"

usage() {
  cat <<'EOF'
Usage:
  codex-usage <turn-id|record-number> [--profile simple|coding|agentic] [--config <path>] [--no-config] [--json]

Defaults:
  profile: coding
  config:  ~/.config/token-lens/config.json (optional)

Examples:
  codex-usage 1
  codex-usage 3 --profile agentic
  codex-usage T-3aa6eba0
  codex-usage T-3aa6eba0 --profile agentic
  codex-usage T-3aa6eba0 --config ~/.config/token-lens/config.json
  codex-usage T-3aa6eba0 --no-config --json
EOF
}

die() {
  echo "Error: $*" >&2
  exit 1
}

command -v jq >/dev/null 2>&1 || die "jq is required."
command -v rg >/dev/null 2>&1 || die "ripgrep (rg) is required."
[[ -d "$SESSIONS_DIR" ]] || die "Codex sessions directory not found: $SESSIONS_DIR"

# Built-in profiles are deliberately hardcoded so codex-usage works with no config file.
load_profile() {
  case "$1" in
    simple)
      E_G=3000; E_O=8000; E_W=20000
      U_G=2000; U_O=6000; U_W=15000
      C_G=85; C_O=70; C_W=50
      I_G=25000; I_O=60000; I_W=120000
      R_G=500; R_O=2000; R_W=6000
      T_G=2; T_O=4; T_W=8
      ;;
    coding)
      E_G=8000; E_O=20000; E_W=50000
      U_G=6000; U_O=15000; U_W=35000
      C_G=80; C_O=60; C_W=35
      I_G=50000; I_O=150000; I_W=300000
      R_G=1000; R_O=4000; R_W=12000
      T_G=3; T_O=8; T_W=15
      ;;
    agentic)
      E_G=15000; E_O=40000; E_W=100000
      U_G=10000; U_O=30000; U_W=75000
      C_G=75; C_O=50; C_W=25
      I_G=100000; I_O=300000; I_W=700000
      R_G=2000; R_O=8000; R_W=25000
      T_G=5; T_O=15; T_W=30
      ;;
    *) die "Unknown criteria profile: $1" ;;
  esac

  W_E=30; W_U=25; W_C=20; W_I=10; W_R=10; W_T=5
}

load_health_profile() {
  H_CONTEXT_WINDOW=400000
  H_CACHE_MIN_TURNS=3
  H_CACHE_MIN_INPUT=20000
  H_CACHE_G=75; H_CACHE_O=50; H_CACHE_W=25
  case "$1" in
    simple) H_COST_G=30000; H_COST_O=75000; H_COST_W=150000; H_LOOP_G=4; H_LOOP_O=10; H_LOOP_W=20 ;;
    coding) H_COST_G=60000; H_COST_O=150000; H_COST_W=300000; H_LOOP_G=8; H_LOOP_O=20; H_LOOP_W=40 ;;
    agentic) H_COST_G=120000; H_COST_O=300000; H_COST_W=600000; H_LOOP_G=15; H_LOOP_O=40; H_LOOP_W=80 ;;
  esac
}

requested=""
profile="coding"
profile_explicit=0
output_mode="table"
config_mode="auto"
config_path="$HOME/.config/token-lens/config.json"

while (( $# > 0 )); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --json) output_mode="json"; shift ;;
    --profile)
      (( $# >= 2 )) || die "--profile requires a value."
      profile="$2"; profile_explicit=1; shift 2
      ;;
    --config)
      (( $# >= 2 )) || die "--config requires a path."
      config_path="$2"; config_mode="required"; shift 2
      ;;
    --no-config) config_mode="disabled"; shift ;;
    --*) die "Unknown option: $1" ;;
    *)
      [[ -z "$requested" ]] || die "Only one turn ID may be provided."
      requested="$1"; shift
      ;;
  esac
done

[[ -n "$requested" ]] || { usage; exit 1; }

# A positive integer means Nth newest turn, using codex-turns ordering.
if [[ "$requested" =~ ^[0-9]+$ ]]; then
  (( requested >= 1 )) || die "Record number must be a positive integer."
  turns_cmd="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/codex-turns"
  [[ -x "$turns_cmd" ]] || die "codex-turns executable not found: $turns_cmd"
  ranked_id="$("$turns_cmd" "$requested" --json 2>/dev/null | jq -r --argjson n "$requested" '.[$n - 1].short_id // empty')"
  [[ -n "$ranked_id" ]] || die "Codex record #$requested does not exist."
  requested="$ranked_id"
fi

config_source="built-in defaults"
if [[ "$config_mode" != "disabled" ]]; then
  if [[ -f "$config_path" ]]; then
    jq -e . "$config_path" >/dev/null 2>&1 || die "Invalid JSON config: $config_path"
    if (( profile_explicit == 0 )); then
      configured_profile="$(jq -r '.default_profile // empty' "$config_path")"
      [[ -z "$configured_profile" ]] || profile="$configured_profile"
    fi
    config_source="$config_path"
  elif [[ "$config_mode" == "required" ]]; then
    die "Config file not found: $config_path"
  fi
fi

load_profile "$profile"
load_health_profile "$profile"

config_value() {
  local path="$1"
  [[ "$config_source" != "built-in defaults" ]] || return 0
  jq -r --arg p "$profile" --arg path "$path" '
    (["profiles", $p] + ($path | split("."))) as $keys
    | getpath($keys) // empty
  ' "$config_path"
}

apply_override() {
  local variable="$1" path="$2" value
  value="$(config_value "$path")"
  [[ -z "$value" ]] || printf -v "$variable" '%s' "$value"
}

apply_override E_G criteria.effective_used_tokens.great_lt
apply_override E_O criteria.effective_used_tokens.good_lt
apply_override E_W criteria.effective_used_tokens.watch_lt
apply_override U_G criteria.uncached_input_tokens.great_lt
apply_override U_O criteria.uncached_input_tokens.good_lt
apply_override U_W criteria.uncached_input_tokens.watch_lt
apply_override C_G criteria.cache_ratio_percent.great_gte
apply_override C_O criteria.cache_ratio_percent.good_gte
apply_override C_W criteria.cache_ratio_percent.watch_gte
apply_override I_G criteria.input_tokens.great_lt
apply_override I_O criteria.input_tokens.good_lt
apply_override I_W criteria.input_tokens.watch_lt
apply_override R_G criteria.reasoning_output_tokens.great_lt
apply_override R_O criteria.reasoning_output_tokens.good_lt
apply_override R_W criteria.reasoning_output_tokens.watch_lt
apply_override T_G criteria.turns.great_lte
apply_override T_O criteria.turns.good_lte
apply_override T_W criteria.turns.watch_lte
apply_override W_E weights.effective_used_tokens
apply_override W_U weights.uncached_input_tokens
apply_override W_C weights.cache_ratio_percent
apply_override W_I weights.input_tokens
apply_override W_R weights.reasoning_output_tokens
apply_override W_T weights.turns
apply_override H_CONTEXT_WINDOW health.context_window_tokens
apply_override H_COST_G health.cost_equivalent_per_turn.great_lt
apply_override H_COST_O health.cost_equivalent_per_turn.good_lt
apply_override H_COST_W health.cost_equivalent_per_turn.watch_lt
apply_override H_LOOP_G health.loop_turns.great_lte
apply_override H_LOOP_O health.loop_turns.good_lte
apply_override H_LOOP_W health.loop_turns.watch_lte
apply_override H_CACHE_G health.cache_ratio_percent.great_gte
apply_override H_CACHE_O health.cache_ratio_percent.good_gte
apply_override H_CACHE_W health.cache_ratio_percent.watch_gte
apply_override H_CACHE_MIN_TURNS health.cache_ratio_percent.min_turns
apply_override H_CACHE_MIN_INPUT health.cache_ratio_percent.min_input_tokens

for value in "$E_G" "$E_O" "$E_W" "$U_G" "$U_O" "$U_W" "$C_G" "$C_O" "$C_W" "$I_G" "$I_O" "$I_W" "$R_G" "$R_O" "$R_W" "$T_G" "$T_O" "$T_W" "$W_E" "$W_U" "$W_C" "$W_I" "$W_R" "$W_T" "$H_CONTEXT_WINDOW" "$H_COST_G" "$H_COST_O" "$H_COST_W" "$H_LOOP_G" "$H_LOOP_O" "$H_LOOP_W" "$H_CACHE_G" "$H_CACHE_O" "$H_CACHE_W" "$H_CACHE_MIN_TURNS" "$H_CACHE_MIN_INPUT"; do
  [[ "$value" =~ ^[0-9]+$ ]] || die "Criteria and weights must be non-negative integers."
done

(( E_G < E_O && E_O < E_W )) || die "Invalid Effective thresholds for profile: $profile"
(( U_G < U_O && U_O < U_W )) || die "Invalid Uncached thresholds for profile: $profile"
(( C_G > C_O && C_O > C_W )) || die "Invalid Cache thresholds for profile: $profile"
(( I_G < I_O && I_O < I_W )) || die "Invalid Input thresholds for profile: $profile"
(( R_G < R_O && R_O < R_W )) || die "Invalid Reasoning thresholds for profile: $profile"
(( T_G < T_O && T_O < T_W )) || die "Invalid Turns thresholds for profile: $profile"
(( W_E > 0 && W_U > 0 && W_C > 0 && W_I > 0 && W_R > 0 && W_T > 0 )) || die "All metric weights must be positive."
(( H_CONTEXT_WINDOW > 0 )) || die "health.context_window_tokens must be positive."
(( H_COST_G < H_COST_O && H_COST_O < H_COST_W )) || die "Invalid recommended cost thresholds for profile: $profile"
(( H_LOOP_G < H_LOOP_O && H_LOOP_O < H_LOOP_W )) || die "Invalid recommended loop thresholds for profile: $profile"
(( H_CACHE_G > H_CACHE_O && H_CACHE_O > H_CACHE_W )) || die "Invalid recommended cache thresholds for profile: $profile"

turn_id=""

if [[ "$requested" == T-* ]]; then
  suffix="${requested#T-}"

  matches="$(
    rg -l --fixed-strings "$suffix" "$SESSIONS_DIR" -g '*.jsonl' 2>/dev/null |
    while IFS= read -r file; do
      jq -r --arg suffix "$suffix" '
        select(.type == "token_usage_record")
        | .payload.turn_id
        | select(type == "string" and endswith($suffix))
      ' "$file" 2>/dev/null
    done |
    sed '/^$/d' |
    sort -u
  )"

  count="$(printf '%s\n' "$matches" | sed '/^$/d' | wc -l | tr -d ' ')"

  [[ "$count" -gt 0 ]] || die "Short ID not found: $requested"

  if [[ "$count" -gt 1 ]]; then
    echo "Short ID is ambiguous:" >&2
    printf '%s\n' "$matches" >&2
    exit 1
  fi

  turn_id="$matches"
else
  turn_id="$requested"
fi

short="T-${turn_id: -8}"

hit="$(
  rg -l --fixed-strings "$turn_id" "$SESSIONS_DIR" -g '*.jsonl' 2>/dev/null |
  head -1
)"

[[ -n "$hit" ]] || die "Turn ID not found: $turn_id"

root="$(
  jq -r --arg id "$turn_id" '
    select(
      .type == "token_usage_record"
      and .payload.turn_id == $id
    )
    | (.payload.root_turn_id // .payload.turn_id)
  ' "$hit" 2>/dev/null |
  tail -1
)"

[[ -n "$root" && "$root" != "null" ]] || root="$turn_id"

tmp="$(mktemp -t codex-usage.XXXXXX)"
trap 'rm -f "$tmp"' EXIT INT TERM

rg -l --fixed-strings "$root" "$SESSIONS_DIR" -g '*.jsonl' 2>/dev/null |
while IFS= read -r file; do
  jq -c --arg root "$root" '
    select(
      .type == "token_usage_record"
      and (
        ((.payload.root_turn_id // .payload.turn_id) == $root)
        or (.payload.turn_id == $root)
      )
    )
  ' "$file" 2>/dev/null
done > "$tmp"

[[ -s "$tmp" ]] || die "No token usage records found for root turn: $root"

report="$(
  jq -s \
    --arg id "$turn_id" \
    --arg short "$short" \
    --arg root "$root" '
      group_by(.payload.turn_id)
      | map(max_by(.timestamp))
      | . as $records
      | (
          $records
          | map(select(.payload.turn_id == $id))
          | first
        ) as $selected
      | {
          id: {
            short_id: $short,
            turn_id: $id,
            root_turn_id: $root,
            session_id: ($selected.payload.session_id // null)
          },
          selected_turn:
            (
              if $selected == null then null
              else
                ($selected.payload.turn_token_usage // {}) as $t
                | $t + {
                    uncached_input_tokens:
                      (($t.input_tokens // 0) - ($t.cached_input_tokens // 0)),
                    effective_used_tokens:
                      (
                        ($t.input_tokens // 0)
                        - ($t.cached_input_tokens // 0)
                        + ($t.output_tokens // 0)
                      ),
                    cache_ratio_percent:
                      (
                        if ($t.input_tokens // 0) > 0
                        then (
                          ((($t.cached_input_tokens // 0) / $t.input_tokens) * 100)
                          | round
                        )
                        else 0
                        end
                      )
                  }
              end
            ),
          whole_task: {
            turns: ($records | length),
            sessions:
              (
                $records
                | map(.payload.session_id)
                | map(select(. != null))
                | unique
                | length
              ),
            input_tokens:
              (
                $records
                | map(.payload.turn_token_usage.input_tokens // 0)
                | add // 0
              ),
            cached_input_tokens:
              (
                $records
                | map(.payload.turn_token_usage.cached_input_tokens // 0)
                | add // 0
              ),
            uncached_input_tokens:
              (
                $records
                | map(
                    (.payload.turn_token_usage.input_tokens // 0)
                    - (.payload.turn_token_usage.cached_input_tokens // 0)
                  )
                | add // 0
              ),
            output_tokens:
              (
                $records
                | map(.payload.turn_token_usage.output_tokens // 0)
                | add // 0
              ),
            reasoning_output_tokens:
              (
                $records
                | map(.payload.turn_token_usage.reasoning_output_tokens // 0)
                | add // 0
              ),
            effective_used_tokens:
              (
                $records
                | map(
                    (.payload.turn_token_usage.input_tokens // 0)
                    - (.payload.turn_token_usage.cached_input_tokens // 0)
                    + (.payload.turn_token_usage.output_tokens // 0)
                  )
                | add // 0
              ),
            max_turn_input_tokens:
              (
                $records
                | map(.payload.turn_token_usage.input_tokens // 0)
                | max // 0
              )
          }
        }
    ' "$tmp"
)" || die "Failed to build report."

effective="$(printf '%s\n' "$report" | jq -r '.whole_task.effective_used_tokens')"
uncached="$(printf '%s\n' "$report" | jq -r '.whole_task.uncached_input_tokens')"
cached="$(printf '%s\n' "$report" | jq -r '.whole_task.cached_input_tokens')"
output="$(printf '%s\n' "$report" | jq -r '.whole_task.output_tokens')"
cache_ratio="$(printf '%s\n' "$report" | jq -r 'if .whole_task.input_tokens > 0 then (((.whole_task.cached_input_tokens / .whole_task.input_tokens) * 100) | round) else 0 end')"
input="$(printf '%s\n' "$report" | jq -r '.whole_task.input_tokens')"
reasoning="$(printf '%s\n' "$report" | jq -r '.whole_task.reasoning_output_tokens')"
turns="$(printf '%s\n' "$report" | jq -r '.whole_task.turns')"
max_turn_input="$(printf '%s\n' "$report" | jq -r '.whole_task.max_turn_input_tokens')"

format_int() {
  awk -v n="$1" 'BEGIN {
    s = sprintf("%.0f", n)
    neg = (substr(s,1,1) == "-")
    if (neg) s = substr(s,2)
    out = ""
    while (length(s) > 3) {
      out = "," substr(s,length(s)-2) out
      s = substr(s,1,length(s)-3)
    }
    print (neg ? "-" : "") s out
  }'
}

rate_low_better() {
  local value="$1" great="$2" good="$3" watch="$4"
  if (( value < great )); then printf '0|GREAT'
  elif (( value < good )); then printf '1|GOOD'
  elif (( value < watch )); then printf '2|WATCH'
  else printf '3|BAD'
  fi
}

rate_cache() {
  local value="$1" great="$2" good="$3" watch="$4"
  if (( value >= great )); then printf '0|GREAT'
  elif (( value >= good )); then printf '1|GOOD'
  elif (( value >= watch )); then printf '2|WATCH'
  else printf '3|BAD'
  fi
}

rate_turns() {
  local value="$1" great="$2" good="$3" watch="$4"
  if (( value <= great )); then printf '0|GREAT'
  elif (( value <= good )); then printf '1|GOOD'
  elif (( value <= watch )); then printf '2|WATCH'
  else printf '3|BAD'
  fi
}

rating_label() {
  case "$1" in
    GREAT) printf '🟢 GREAT' ;;
    GOOD) printf '🔵 GOOD' ;;
    WATCH) printf '🟡 WATCH' ;;
    BAD) printf '🔴 BAD' ;;
    N/A) printf '⚪ N/A' ;;
  esac
}

# Legacy scoring is kept for compatibility and comparison.
r1="$(rate_low_better "$effective" "$E_G" "$E_O" "$E_W")"
r2="$(rate_low_better "$uncached" "$U_G" "$U_O" "$U_W")"
r3="$(rate_cache "$cache_ratio" "$C_G" "$C_O" "$C_W")"
r4="$(rate_low_better "$input" "$I_G" "$I_O" "$I_W")"
r5="$(rate_low_better "$reasoning" "$R_G" "$R_O" "$R_W")"
r6="$(rate_turns "$turns" "$T_G" "$T_O" "$T_W")"

s1="${r1%%|*}"; n1="${r1#*|}"; l1="$(rating_label "$n1")"
s2="${r2%%|*}"; n2="${r2#*|}"; l2="$(rating_label "$n2")"
s3="${r3%%|*}"; n3="${r3#*|}"; l3="$(rating_label "$n3")"
s4="${r4%%|*}"; n4="${r4#*|}"; l4="$(rating_label "$n4")"
s5="${r5%%|*}"; n5="${r5#*|}"; l5="$(rating_label "$n5")"
s6="${r6%%|*}"; n6="${r6#*|}"; l6="$(rating_label "$n6")"

legacy_score="$(jq -nr \
  --argjson s1 "$s1" --argjson w1 "$W_E" \
  --argjson s2 "$s2" --argjson w2 "$W_U" \
  --argjson s3 "$s3" --argjson w3 "$W_C" \
  --argjson s4 "$s4" --argjson w4 "$W_I" \
  --argjson s5 "$s5" --argjson w5 "$W_R" \
  --argjson s6 "$s6" --argjson w6 "$W_T" \
  '(($s1*$w1)+($s2*$w2)+($s3*$w3)+($s4*$w4)+($s5*$w5)+($s6*$w6)) / ($w1+$w2+$w3+$w4+$w5+$w6)')"

legacy_name="BAD"
if jq -n -e --argjson x "$legacy_score" '$x < 0.75' >/dev/null; then legacy_name="GREAT"
elif jq -n -e --argjson x "$legacy_score" '$x < 1.50' >/dev/null; then legacy_name="GOOD"
elif jq -n -e --argjson x "$legacy_score" '$x < 2.25' >/dev/null; then legacy_name="WATCH"
fi
if (( s2 == 3 && s3 == 3 )); then legacy_name="BAD"
elif (( s1 == 3 && s2 >= 2 )) && [[ "$legacy_name" == GREAT || "$legacy_name" == GOOD ]]; then legacy_name="WATCH"
fi
legacy_label="$(rating_label "$legacy_name")"

# Recommended health: price-adjusted work, cache reuse, context pressure, and loops.
# Baseline cost-equivalent factors for Codex: uncached=1.0x, cached=0.10x, output=8.0x.
cost_equiv=$(( uncached + (cached + 5) / 10 + output * 8 ))
cost_per_turn=$(( cost_equiv / (turns > 0 ? turns : 1) ))
context_pressure=$(( max_turn_input * 100 / H_CONTEXT_WINDOW ))

cost_r="$(rate_low_better "$cost_per_turn" "$H_COST_G" "$H_COST_O" "$H_COST_W")"
cost_s="${cost_r%%|*}"; cost_n="${cost_r#*|}"; cost_l="$(rating_label "$cost_n")"

cache_available=1
if (( turns < H_CACHE_MIN_TURNS || input < H_CACHE_MIN_INPUT )); then
  cache_available=0; cache_s=0; cache_n="N/A"; cache_l="$(rating_label N/A)"
else
  cache_r="$(rate_cache "$cache_ratio" "$H_CACHE_G" "$H_CACHE_O" "$H_CACHE_W")"
  cache_s="${cache_r%%|*}"; cache_n="${cache_r#*|}"; cache_l="$(rating_label "$cache_n")"
fi

context_r="$(rate_low_better "$context_pressure" 30 50 75)"
context_s="${context_r%%|*}"; context_n="${context_r#*|}"; context_l="$(rating_label "$context_n")"
loop_r="$(rate_turns "$turns" "$H_LOOP_G" "$H_LOOP_O" "$H_LOOP_W")"
loop_s="${loop_r%%|*}"; loop_n="${loop_r#*|}"; loop_l="$(rating_label "$loop_n")"

health_num=$(( cost_s * 35 + context_s * 30 + loop_s * 10 ))
health_den=75
if (( cache_available )); then
  health_num=$(( health_num + cache_s * 25 ))
  health_den=100
fi
health_score="$(jq -nr --argjson n "$health_num" --argjson d "$health_den" '$n / $d')"
health_name="BAD"
if jq -n -e --argjson x "$health_score" '$x < 0.75' >/dev/null; then health_name="GREAT"
elif jq -n -e --argjson x "$health_score" '$x < 1.50' >/dev/null; then health_name="GOOD"
elif jq -n -e --argjson x "$health_score" '$x < 2.25' >/dev/null; then health_name="WATCH"
fi

# BAD is reserved for strong pressure/waste evidence, not task size alone.
if (( context_pressure >= 90 )); then
  health_name="BAD"
elif (( cache_available && cache_s == 3 && cost_s >= 2 )); then
  health_name="BAD"
elif [[ "$health_name" == "BAD" && $context_s -lt 3 && $cost_s -lt 3 ]]; then
  health_name="WATCH"
fi
health_label="$(rating_label "$health_name")"

legacy_health="$(jq -n \
  --arg overall "$legacy_name" --argjson weighted_score "$legacy_score" \
  '{overall:$overall,weighted_score:$weighted_score}')"
recommended_health="$(jq -n \
  --arg overall "$health_name" --argjson score "$health_score" \
  --argjson cost_equivalent_tokens "$cost_equiv" \
  --argjson cost_equivalent_per_turn "$cost_per_turn" \
  --argjson context_pressure_percent "$context_pressure" \
  --argjson max_turn_input_tokens "$max_turn_input" \
  --argjson context_window_tokens "$H_CONTEXT_WINDOW" \
  --arg cache_status "$cache_n" --arg cost_status "$cost_n" \
  --arg context_status "$context_n" --arg loop_status "$loop_n" \
  '{overall:$overall,score:$score,cost_equivalent_tokens:$cost_equivalent_tokens,cost_equivalent_per_turn:$cost_equivalent_per_turn,cache_status:$cache_status,context_pressure_percent:$context_pressure_percent,max_turn_input_tokens:$max_turn_input_tokens,context_window_tokens:$context_window_tokens,cost_status:$cost_status,context_status:$context_status,loop_status:$loop_status}')"

if [[ "$output_mode" == "json" ]]; then
  jq -n --argjson report "$report" --argjson legacy "$legacy_health" --argjson recommended "$recommended_health" \
    '$report + {legacy_health:$legacy,recommended_health:$recommended}'
  exit 0
fi

echo
echo "Codex Token Health"
echo "------------------------------------------------------------"
echo "Turn: $short"
echo "Criteria profile: $profile"
echo "Config: $config_source"
echo
echo "Raw task metrics (legacy criteria)"
printf "%-4s %-34s %14s   %s\n" "#" "METRIC" "VALUE" "RATING"
printf "%-4s %-34s %14s   %s\n" "1" "effective_used_tokens" "$(format_int "$effective")" "$l1"
printf "%-4s %-34s %14s   %s\n" "2" "uncached_input_tokens" "$(format_int "$uncached")" "$l2"
printf "%-4s %-34s %13s%%   %s\n" "3" "cache_ratio_percent" "$cache_ratio" "$l3"
printf "%-4s %-34s %14s   %s\n" "4" "input_tokens" "$(format_int "$input")" "$l4"
printf "%-4s %-34s %14s   %s\n" "5" "reasoning_output_tokens" "$(format_int "$reasoning")" "$l5"
printf "%-4s %-34s %14s   %s\n" "6" "turns" "$(format_int "$turns")" "$l6"
printf "%-4s %-34s %14s   %s\n" "-" "cached_input_tokens" "$(format_int "$cached")" "INFO"
printf "%-4s %-34s %14s   %s\n" "-" "output_tokens" "$(format_int "$output")" "INFO"

echo
printf "LEGACY OVERALL: %s  (weighted score: %.2f)\n" "$legacy_label" "$legacy_score"
echo
echo "Legacy criteria: $profile (size-oriented; kept for compatibility)"
printf "  %-3s %-12s %-18s %-18s %-18s %-18s\n" "#" "METRIC" "GREAT" "GOOD" "WATCH" "BAD"
printf "  %-3s %-12s %-18s %-18s %-18s %-18s\n" "1" "Effective" "<$(format_int "$E_G")" "$(format_int "$E_G")-<$(format_int "$E_O")" "$(format_int "$E_O")-<$(format_int "$E_W")" ">=$(format_int "$E_W")"
printf "  %-3s %-12s %-18s %-18s %-18s %-18s\n" "2" "Uncached" "<$(format_int "$U_G")" "$(format_int "$U_G")-<$(format_int "$U_O")" "$(format_int "$U_O")-<$(format_int "$U_W")" ">=$(format_int "$U_W")"
printf "  %-3s %-12s %-18s %-18s %-18s %-18s\n" "3" "Cache" ">=$C_G%" "$C_O-<$C_G%" "$C_W-<$C_O%" "<$C_W%"
printf "  %-3s %-12s %-18s %-18s %-18s %-18s\n" "4" "Input" "<$(format_int "$I_G")" "$(format_int "$I_G")-<$(format_int "$I_O")" "$(format_int "$I_O")-<$(format_int "$I_W")" ">=$(format_int "$I_W")"
printf "  %-3s %-12s %-18s %-18s %-18s %-18s\n" "5" "Reasoning" "<$(format_int "$R_G")" "$(format_int "$R_G")-<$(format_int "$R_O")" "$(format_int "$R_O")-<$(format_int "$R_W")" ">=$(format_int "$R_W")"
printf "  %-3s %-12s %-18s %-18s %-18s %-18s\n" "6" "Turns" "<=$T_G" "$((T_G+1))-$T_O" "$((T_O+1))-$T_W" ">=$((T_W+1))"

echo
echo "------------------------------------------------------------"
echo "Efficiency Health (recommended)"
printf "%-22s %-42s %s\n" "DIMENSION" "VALUE" "STATUS"
printf "%-22s %-42s %s\n" "Cost load" "$(format_int "$cost_equiv") eq total / $(format_int "$cost_per_turn") per turn" "$cost_l"
if (( cache_available )); then
  printf "%-22s %-42s %s\n" "Cache efficiency" "$cache_ratio% reuse" "$cache_l"
else
  printf "%-22s %-42s %s\n" "Cache efficiency" "N/A (<${H_CACHE_MIN_TURNS} turns or <$(format_int "$H_CACHE_MIN_INPUT") input)" "$cache_l"
fi
printf "%-22s %-42s %s\n" "Context pressure" "$context_pressure% ($(format_int "$max_turn_input") / $(format_int "$H_CONTEXT_WINDOW"))" "$context_l"
printf "%-22s %-42s %s\n" "Loop behavior" "$(format_int "$turns") turns" "$loop_l"
echo
printf "OVERALL HEALTH: %s  (score: %.2f)\n" "$health_label" "$health_score"
echo "Cost-equivalent baseline: uncached 1.0x + cached 0.10x + output 8.0x."
echo "Raw task size alone does not force BAD; strong context pressure or combined cache/cost waste does."
echo
echo "Legend: 🟢 GREAT   🔵 GOOD   🟡 WATCH   🔴 BAD   ⚪ N/A"
