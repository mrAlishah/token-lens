#!/usr/bin/env bash
set -u

SESSIONS_DIR="${CODEX_SESSIONS_DIR:-$HOME/.codex/sessions}"

usage() {
  cat <<'USAGE'
Usage:
  codex-turns [limit]
  codex-turns --limit <n>
  codex-turns [limit] --json

Lists the most recent unique Codex turns from ~/.codex/sessions.
USAGE
}

die() { echo "Error: $*" >&2; exit 1; }

command -v jq >/dev/null 2>&1 || die "jq is required."
[[ -d "$SESSIONS_DIR" ]] || die "Codex sessions directory not found: $SESSIONS_DIR"

limit=10
output_mode="table"

while (( $# > 0 )); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --json) output_mode="json"; shift ;;
    -n|--limit)
      (( $# >= 2 )) || die "$1 requires a value."
      limit="$2"; shift 2 ;;
    *[!0-9]*|'') die "Unknown argument: $1" ;;
    *) limit="$1"; shift ;;
  esac
done

[[ "$limit" =~ ^[1-9][0-9]*$ ]] || die "Limit must be a positive integer."

tmp="$(mktemp -t codex-turns.XXXXXX)"
trap 'rm -f "$tmp"' EXIT INT TERM

while IFS= read -r -d '' file; do
  jq -rcs --arg file "$file" '
    ([.[]
      | select(.type == "session_meta")
      | (.payload.cwd // .payload.project_path // .cwd // empty)
      | select(type == "string" and length > 0)
    ] | first // "") as $session_source
    | ([.[]
      | select(.type == "session_meta")
      | (.payload.model // .payload.model_name // empty)
      | select(type == "string" and length > 0)
    ] | first // "") as $session_model
    | .[]
    | select(.type == "token_usage_record")
    | select(.payload.turn_id | type == "string")
    | {
        timestamp: (.timestamp // ""),
        turn_id: .payload.turn_id,
        root_turn_id: (.payload.root_turn_id // .payload.turn_id),
        session_id: (.payload.session_id // ""),
        model: (.payload.model // $session_model // ""),
        source: (.payload.cwd // .payload.project_path // $session_source // "")
      }
  ' "$file" 2>/dev/null
done < <(find "$SESSIONS_DIR" -type f -name '*.jsonl' -print0) \
  | jq -sc --argjson limit "$limit" '
      sort_by(.timestamp)
      | group_by(.turn_id)
      | map(max_by(.timestamp))
      | sort_by(.timestamp) | reverse
      | .[:$limit]
      | map(. + {
          short_id: ("T-" + .turn_id[-8:]),
          short_root_id:
            (
              if .root_turn_id != .turn_id then
                ("T-" + .root_turn_id[-8:])
              elif (.session_id | length) > 0 then
                ("S-" + .session_id[-8:])
              else
                "-"
              end
            )
        })
    ' > "$tmp"

if [[ "$output_mode" == "json" ]]; then
  cat "$tmp"
  exit 0
fi

printf "%-22s %-11s %-11s %-38s %-38s %-24s %s\n" \
  "TIME" "SHORT-ID" "ROOT-ID" "SESSION-ID" "TURN-ID" "MODEL" "SOURCE"

jq -r '.[] | [
  .timestamp,
  .short_id,
  .short_root_id,
  (.session_id // ""),
  .turn_id,
  (.model // ""),
  (.source // "")
] | @tsv' "$tmp" |
while IFS=$'\t' read -r ts short root session turn model source; do
  printf "%-22s %-11s %-11s %-38s %-38s %-24s %s\n" \
    "$ts" "$short" "$root" "${session:--}" "$turn" "${model:--}" "${source:--}"
done
